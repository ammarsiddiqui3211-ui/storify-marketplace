{
  "name": "storify-marketplace",
  "version": "1.0.3",
  "description": "Storify Marketplace - Dual Web & Android Application",
  "main": "index.html",
  "scripts": {
    "start": "npx serve -l 3000 .",
    "dev": "npx serve -l 3000 .",
    "build": "node build.js",
    "sync": "npm run build && cap sync android",
    "open:android": "cap open android",
    "bundle:release": "npm run sync && cd android && gradlew.bat bundleRelease"
  },
  "keywords": [
    "storify",
    "marketplace",
    "pwa",
    "capacitor",
    "android"
  ],
  "author": "Storify Marketplace",
  "license": "ISC",
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/status-bar": "^6.0.2",
    "@vercel/analytics": "^2.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
